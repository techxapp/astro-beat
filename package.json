    "e2e": "playwright test",
    "inversion-report": "pnpm --filter @astro/fixtures inversion-report",
    "licenses:check": "node scripts/check-licenses.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.56.1",
    "eslint": "^9.39.0",
    "fast-check": "^4.10.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
